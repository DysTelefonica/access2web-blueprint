# Workflow de release del consumer (HR-19, HR-20; canon #1015).
#
# Para adoptarlo: copie este fichero a `.github/workflows/release.yml` y
# cambie los valores del bloque `env` de abajo. Fuera de él hay otros dos
# parámetros, porque GitHub no deja leer `env` en esos campos (#1456):
#
#   runner   las cuatro líneas `runs-on: ...  # RELEASE_RUNS_ON`. Cámbielas
#            las cuatro por el mismo valor, por ejemplo
#            `[self-hosted, Linux, <pool>]`. Es un literal a propósito: un
#            `runs-on` dinámico es hallazgo del gate de perfil de runners
#            (HR-61) en un consumer self-hosted.
#   entorno  la variable del repositorio RELEASE_ENVIRONMENT. Sin definir,
#            el job `release` publica en el entorno protegido `release`.
#            Con otro nombre, en ese entorno; con `none`, sin entorno (repos
#            privados del plan Free, donde no existen los entornos
#            protegidos). Sin entorno no hay aprobación previa: publicar
#            depende solo de los dos gates de `preflight`.
#
# Los jobs no llevan ramas ni nombres de repositorios.
#
# Se dispara con un **tag estable**: `v*` y nunca `v*-*`. Un prerelease
# (`v2.2.0-rc.1`) no se publica —el gate del tag solo acepta semver estricto,
# así que dispararse con él solo podría poner el repositorio en rojo—.
#
#   preflight  los dos gates: el tag (semver anotado, versión creciente,
#              commit alcanzable desde la rama por defecto) y el CI en verde
#              sobre el commit exacto que se etiqueta.
#   release    publica en el entorno protegido `release` (o el de
#              RELEASE_ENVIRONMENT). El token con permiso de escritura vive
#              solo en este job.
#   verify     comprueba que lo publicado corresponde al tag. Es una
#              comprobación de salida, no una batería de tests: el CI ya
#              quedó verde en preflight y no se repite aquí. La comprobación
#              de lo desplegado puede declararse aplazada (RELEASE_VERIFY).
#   provenance solo si existe el fichero de IMAGE_PROVENANCE_CONFIG (consumers
#              que construyen la imagen fuera del CI, HR-83): sube a la
#              release el manifiesto sha256 del árbol desplegable en el
#              commit del tag, contra el que el gate de despliegue compara
#              la imagen antes de `oc set image`.

name: Release

on:
  push:
    tags:
      - "v*"
      - "!v*-*"
  # Re-publicar un tag que ya existe con el workflow de la rama por defecto.
  # Un push de tag ejecuta el workflow de SU commit: si un defecto del propio
  # workflow «quemó» esa versión, solo se repite así (fase 0, 0.3). El
  # preflight sigue exigiendo tag anotado, semver estable y alcanzable desde
  # la rama por defecto, y CI en verde sobre su commit.
  workflow_dispatch:
    inputs:
      tag:
        description: "Tag estable que ya existe (vX.Y.Z) y se vuelve a publicar"
        required: true
        type: string

# El workflow es de solo lectura por defecto. Solo el job de publicación
# recibe la capacidad de escritura, y solo mientras dura.
permissions:
  contents: read

concurrency:
  group: release-${{ inputs.tag || github.ref_name }}
  # Nunca se cancela una release en curso: dos tags a la vez no se
  # entrelazan, y una publicación a medias no se relanza sola.
  cancel-in-progress: false

env:
  # El tag que se publica: el del push, o el que se pidió a mano. No es un
  # parámetro: todos los jobs leen el tag de aquí y nunca de GITHUB_REF_NAME,
  # que en un dispatch es la rama.
  RELEASE_TAG: ${{ inputs.tag || github.ref_name }}
  # 1. Raíz donde el propagador materializó la skill: `.agents/skills/` en
  #    los consumers del catálogo, `skills/` en los que la usan en local.
  CI_PATTERN_ROOT: .agents/skills/ci-pattern
  # 2. Basename del workflow de CI cuyo run en verde exige el gate.
  CI_WORKFLOW: ci.yml
  #    Si su CI ejecuta una suite solo en el push del tag (un E2E caro, por
  #    ejemplo), ponga CI_TAG_RUN a "true": el gate mide el run de ese push y
  #    no el del push a la rama, y como los dos workflows arrancan a la vez,
  #    espera hasta CI_WAIT_MINUTES a que termine (como mucho 100: el job
  #    preflight tiene 120 de plazo). Con "false" y "0" el gate mide el run
  #    más nuevo sobre el commit y no espera (#1451).
  CI_TAG_RUN: "false"
  CI_WAIT_MINUTES: "0"
  # 3. Script del consumer que comprueba el artefacto ya desplegado.
  RELEASE_VERIFY_SCRIPT: scripts/verify-release-output.sh
  #    Con RELEASE_VERIFY "deferred" el script no se ejecuta: el paso lo
  #    anuncia como aviso, con el motivo, en el log y en el resumen del run.
  #    Úselo solo si el workflow no puede alcanzar lo desplegado (producción
  #    tras una VPN, por ejemplo); el motivo es obligatorio (#1456).
  RELEASE_VERIFY: "run"
  RELEASE_VERIFY_DEFERRED_REASON: ""
  #    Ruta de las notas en el commit etiquetado; `{tag}` se sustituye por el
  #    tag (`docs/releases/{tag}.md`, por ejemplo).
  RELEASE_NOTES_PATH: "RELEASE-{tag}.md"
  # 4. Solo si su endpoint de salud no está donde el script lo espera: la
  #    verificación de salida lee de aquí la revisión desplegada (parámetro 6).
  # RELEASE_HEALTH_URL: ${{ vars.RELEASE_HEALTH_URL }}
  # 5. Parámetros de procedencia de imagen (HR-83, asset `image-provenance`).
  #    Sin ese fichero el job `provenance` no publica nada y lo dice.
  IMAGE_PROVENANCE_CONFIG: .github/image-provenance.json

jobs:
  preflight:
    name: release preflight (tag + CI en verde)
    runs-on: ubuntu-24.04  # RELEASE_RUNS_ON
    # Deja sitio a la espera máxima de CI_WAIT_MINUTES; sin espera, el job
    # termina en segundos.
    timeout-minutes: 120
    permissions:
      contents: read
      # Leer el veredicto del CI de este mismo commit. Release y CI son
      # workflows independientes: sin este permiso el camino de release
      # nunca se entera de que el CI estaba rojo sobre lo que va a firmar.
      actions: read
    steps:
      - name: Checkout del tag exacto
        # actions/checkout v4.4.0
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: refs/tags/${{ env.RELEASE_TAG }}
          fetch-depth: 0
          # actions/checkout descarga con --no-tags: sin esto el ref del tag
          # no existe en el runner y el gate del tag muere sobre un tag que
          # sí está anotado.
          fetch-tags: true
          persist-credentials: false

      - name: El tag anotado del remoto, no el ligero de actions/checkout
        # En un push de tag, actions/checkout crea refs/tags/<tag> como tag
        # ligero sobre el commit, y fetch-tags no lo sobrescribe: el gate
        # veía «lightweight» sobre un tag anotado (cadete v1.3.2). Se trae el
        # objeto del remoto con --force. El token va por la configuración de
        # git en el entorno, nunca en la línea de comandos ni persistido.
        env:
          GH_AUTH: ${{ github.token }}
        run: |
          set -euo pipefail
          auth=$(printf 'x-access-token:%s' "$GH_AUTH" | base64 | tr -d '\n')
          GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0="http.https://github.com/.extraheader" \
            GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $auth" \
            git fetch --force --no-tags origin "refs/tags/$RELEASE_TAG:refs/tags/$RELEASE_TAG"

      - name: Gate del tag (HR-19, HR-20)
        run: python3 "$CI_PATTERN_ROOT/assets/release-gate/check_release_tag.py" --repo . --tag "$RELEASE_TAG" --default-branch main

      - name: Gate de CI en verde sobre el commit del tag (HR-19)
        env:
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          tag_run=()
          case "${CI_TAG_RUN:-false}" in
            true) tag_run=(--tag-run) ;;
            false) ;;
            *) echo "CI_TAG_RUN must be \"true\" or \"false\", got \"$CI_TAG_RUN\"" >&2; exit 2 ;;
          esac
          python3 "$CI_PATTERN_ROOT/assets/release-gate/check_release_ci.py" --repo . --tag "$RELEASE_TAG" --workflow "$CI_WORKFLOW" --wait-minutes "${CI_WAIT_MINUTES:-0}" "${tag_run[@]}"

  release:
    name: publicar la release
    needs: preflight
    runs-on: ubuntu-24.04  # RELEASE_RUNS_ON
    timeout-minutes: 15
    # Entorno protegido: quien lo aprueba es quien aprueba la publicación.
    # Un nombre vacío deja el job sin entorno (RELEASE_ENVIRONMENT `none`).
    environment: ${{ (vars.RELEASE_ENVIRONMENT || 'release') != 'none' && (vars.RELEASE_ENVIRONMENT || 'release') || '' }}
    permissions:
      contents: write
    steps:
      - name: Checkout del tag exacto
        # Las notas y el remoto que usa `gh` salen del commit etiquetado.
        # actions/checkout v4.4.0
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: refs/tags/${{ env.RELEASE_TAG }}
          fetch-depth: 0
          fetch-tags: true
          persist-credentials: false

      - name: Las notas del release están en el commit etiquetado (HR-19)
        run: |
          set -euo pipefail
          notes="${RELEASE_NOTES_PATH:-}"
          [ -n "$notes" ] || notes='RELEASE-{tag}.md'
          notes="${notes//\{tag\}/$RELEASE_TAG}"
          test -f "$notes" || { echo "no están las notas del release: falta $notes en el commit del tag" >&2; exit 1; }
          printf 'RELEASE_NOTES_FILE=%s\n' "$notes" >> "$GITHUB_ENV"

      - name: Crear la GitHub Release y marcarla Latest
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          # Re-publicación a mano (0.3): si la Release del tag ya existe, se
          # conserva y los jobs siguientes la verifican y completan.
          if gh release view "$RELEASE_TAG" >/dev/null 2>&1; then
            echo "la release de $RELEASE_TAG ya existe; se conserva y se verifica"
          else
            gh release create "$RELEASE_TAG" --title "$RELEASE_TAG" --notes-file "$RELEASE_NOTES_FILE" --latest
          fi
      # Sin `--admin`: el tag ya existe y es la release de ese tag, no un
      # movimiento de etiqueta que deba anteponerse a nadie.

  verify:
    name: verificar lo publicado
    needs: release
    runs-on: ubuntu-24.04  # RELEASE_RUNS_ON
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: Checkout del tag exacto
        # actions/checkout v4.4.0
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: refs/tags/${{ env.RELEASE_TAG }}
          fetch-depth: 0
          fetch-tags: true
          persist-credentials: false

      - name: La release publicada es la del tag y está marcada Latest
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          tag_sha=$(git rev-parse "refs/tags/$RELEASE_TAG^{}")
          draft=$(gh api "repos/$GITHUB_REPOSITORY/releases/tags/$RELEASE_TAG" --jq .draft)
          test "$draft" = "false" || { echo "la release de $RELEASE_TAG es un borrador" >&2; exit 1; }
          latest=$(gh api "repos/$GITHUB_REPOSITORY/releases/latest" --jq .tag_name)
          test "$latest" = "$RELEASE_TAG" || { echo "la release Latest es $latest y no $RELEASE_TAG" >&2; exit 1; }
          printf 'RELEASE_SHA=%s\n' "$tag_sha" >> "$GITHUB_ENV"

      - name: Lo desplegado lleva el commit del tag
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          case "${RELEASE_VERIFY:-run}" in
            run) "$RELEASE_VERIFY_SCRIPT" ;;
            deferred)
              if [ -z "${RELEASE_VERIFY_DEFERRED_REASON//[[:space:]]/}" ]; then
                echo "RELEASE_VERIFY is \"deferred\" but RELEASE_VERIFY_DEFERRED_REASON is empty" >&2
                exit 2
              fi
              echo "::warning title=Verificación de lo desplegado aplazada::$RELEASE_VERIFY_DEFERRED_REASON"
              echo "Verificación de lo desplegado APLAZADA: $RELEASE_VERIFY_DEFERRED_REASON"
              printf '**Verificación de lo desplegado aplazada:** %s\n' "$RELEASE_VERIFY_DEFERRED_REASON" >> "$GITHUB_STEP_SUMMARY"
              ;;
            *) echo "RELEASE_VERIFY must be \"run\" or \"deferred\", got \"$RELEASE_VERIFY\"" >&2; exit 2 ;;
          esac

  provenance:
    name: manifiesto de procedencia de la imagen
    needs: release
    runs-on: ubuntu-24.04  # RELEASE_RUNS_ON
    timeout-minutes: 10
    permissions:
      # Subir un asset a la release del tag; nada más.
      contents: write
    steps:
      - name: Checkout del tag exacto
        # actions/checkout v4.4.0
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: refs/tags/${{ env.RELEASE_TAG }}
          fetch-depth: 0
          fetch-tags: true
          persist-credentials: false

      - name: Manifiesto del árbol desplegable como asset de la release (HR-83)
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          if [ ! -f "$IMAGE_PROVENANCE_CONFIG" ]; then
            echo "Sin $IMAGE_PROVENANCE_CONFIG: este consumer no declara imágenes construidas fuera del CI."
            exit 0
          fi
          python3 "$CI_PATTERN_ROOT/assets/image-provenance/image_provenance.py" manifest --config "$IMAGE_PROVENANCE_CONFIG" --repo . --tag "$RELEASE_TAG" --out image-provenance-manifest.json
          gh release upload "$RELEASE_TAG" image-provenance-manifest.json --clobber
