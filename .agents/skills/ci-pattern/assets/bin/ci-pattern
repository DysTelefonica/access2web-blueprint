OPERATING_DOC_HEADER = """# Flujo operativo del repositorio

Documento GENERADO por `ci-pattern adoption generate-doc` a partir de los datos del
repositorio (ci-pattern.yaml, .github/host-contract.json, .github/required-jobs-policy.json,
formularios de issue). NO lo edite a mano: regenérelo con el mismo comando. La deriva la
detecta el gate de documentación operativa de `ci-pattern adoption check`."""


def _operating_doc_params(repo):
    """Parámetros del consumer con defaults del esquema; ilegible → exit 2."""
    params_path = repo / "ci-pattern.yaml"
    if not params_path.is_file():
        raise UsageError(
            f"documentación operativa: falta la entrada ci-pattern.yaml en la raíz "
            f"del repo ({params_path}); el doc se genera desde datos, no a mano")
    schema_path = skill_dir() / "assets" / "parameters.schema.json"
    try:
        schema = json.loads(schema_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise UsageError(f"documentación operativa: esquema de parámetros ilegible: {exc}") from exc
    try:
        text = params_path.read_text(encoding="utf-8")
        params = parse_params_yaml(text)
    except ParamsFileError as exc:
        raise UsageError(f"documentación operativa: ci-pattern.yaml ilegible: {exc}") from exc
    by_key = {f"{p['id']}_{p['name']}": p for p in schema["parameters"]}
    for key in params:
        if key not in by_key:
            raise UsageError(f"documentación operativa: ci-pattern.yaml ilegible: "
                             f"clave desconocida '{key}'")
    for key in OPERATING_DOC_PARAMS:
        param = by_key[key]
        if key not in params:
            if param.get("default") is None:
                raise UsageError(f"documentación operativa: falta {key} en ci-pattern.yaml "
                                 "y no tiene default")
            params[key] = param["default"]
            continue
        err = validate_value(param, params[key])
        if err:
            raise UsageError(f"documentación operativa: ci-pattern.yaml ilegible: {err}")
    return params


def _operating_doc_inputs(repo):
    """Lee y valida el resto de entradas; ilegible → exit 2."""
    try:
        host = json.loads((repo / ".github" / "host-contract.json").read_text(encoding="utf-8"))
        policy = json.loads((repo / ".github" / "required-jobs-policy.json")
                            .read_text(encoding="utf-8"))
    except OSError as exc:
        raise UsageError(f"documentación operativa: entrada ausente o ilegible: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise UsageError(f"documentación operativa: entrada JSON ilegible: {exc}") from exc
    if not isinstance(host, dict):
        raise UsageError("documentación operativa: host-contract.json debe ser un objeto")
    jobs = policy.get("required_jobs") if isinstance(policy, dict) else None
    if not isinstance(jobs, list):
        raise UsageError("documentación operativa: required-jobs-policy.json sin "
                         "'required_jobs' (lista)")
    entrypoint = _local_entrypoint(repo, policy)
    return host, [j for j in jobs if isinstance(j, str)], entrypoint.strip()


