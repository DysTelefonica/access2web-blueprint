#!/usr/bin/env python3
"""ci-pattern — CLI determinista del patrón de CI (adoptador/verificador).

Contrato completo: `references/cli-spec.md` (relativo a la raíz de la skill,
resuelto igual en el catálogo canónico y en cualquier mirror; especificación
normativa). Python 3 stdlib exclusivamente: sin venv, sin
dependencias de terceros, ejecutable con `python3` y desde CI.

Comandos: params validate, verify, status, manifest show, lectura y escritura
del manifiesto, y `adoption check` (gate por fases del contrato de adopción).
`adopt` y `update` están retirados (exit 2 con mensaje accionable): la adopción
la gobierna `adoption check` sobre el contrato del consumer (#376).

La CLI NUNCA ejecuta git merge/push, nunca toca producción, nunca borra
ficheros y nunca sobrescribe un fichero modificado localmente sin
reportarlo como hallazgo.
"""

import fnmatch
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path, PurePosixPath

# #330: el detector del 403 de plan vive en un módulo COMPARTIDO
# (assets/host_plan.py) para que el gate de adopción y el readback del host no
# tengan dos detectores que puedan divergir. Se importa en proceso; nunca se
# invoca la CLI ni un subproceso para leer los datos del consumer.
MANIFEST_NAME = ".governance-manifest.json"
ADOPTION_CONTRACT_NAME = ".github/ci-pattern-adoption.json"
ADOPTION_SCHEMA_VERSION = 1
ADOPTION_PHASES = 7  # fases 0..6 del porting-guide (5 = docs, #279)
SCHEMA_VERSION = 1

EXIT_OK = 0
EXIT_FINDINGS = 1
EXIT_USAGE = 2
EXIT_MISSING = 3
# EXIT_FUTURE retirado (#276): adopt/update ya no devuelven 4; la adopción la gobierna `adoption check`.

LABEL_RE = re.compile(r"^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]*$")

USAGE = """\
uso: ci-pattern <comando> [argumentos]

Comandos:
  params validate <file>     Valida ci-pattern.yaml contra el esquema de parámetros.
  verify <repo> [--json] [--slice-canonical <dir>]
                             Verifica el cumplimiento dirigido por el manifiesto.
  status <repo> [--json]     Resumen de una línea por clase del repo destino.
  manifest show <repo>       Imprime el manifiesto leído.
  adoption check (--phase N | --all) <repo>
                             Gate por fase del contrato de adopción: fases del
                             porting-guide verificadas sobre el árbol real.

`adopt` y `update` están retirados; ver references/cli-spec.md.

Códigos de salida: 0 limpio · 1 hallazgos · 2 uso · 3 recurso ausente.
Contrato: references/cli-spec.md (relativo a la raíz de la skill)
"""


def skill_dir():
    """Raíz de la skill: dos niveles sobre este fichero (assets/bin → skill).

    Resolución self-contained: válida en el catálogo canónico y en cualquier
    mirror de la skill, sin depender de la ruta del repo anfitrión. El override
    por entorno queda como escape para layouts no estándar.
    """
    override = os.environ.get("CI_PATTERN_SKILL_DIR")
    if override:
        return Path(override)
    return Path(__file__).resolve().parents[2]


def _cli_version():
    """Versión de la skill desde el frontmatter de SKILL.md (#186).

    Fuente única de verdad; 'unknown' sólo si el frontmatter no la declara.
    """
    skill_md = skill_dir() / "SKILL.md"
    if skill_md.is_file():
        for line in skill_md.read_text(encoding="utf-8").splitlines():
            if line.strip().startswith("version:"):
                return line.split(":", 1)[1].strip().strip('"')
    return "unknown"


CLI_VERSION = _cli_version()


def _head_sha(repo):
    """HEAD del repo verificado (#186); None si no hay git ni commits."""
    try:
        result = _run_cmd(
            ["git", "-C", str(repo), "rev-parse", "HEAD"], timeout=60)
    except OSError:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


# ---------------------------------------------------------------------------
# Errores
# ---------------------------------------------------------------------------


class UsageError(Exception):
    pass


class MissingResourceError(Exception):
    pass


class ParamsFileError(Exception):
    """Error del parser del subconjunto YAML, con número de línea."""


# ---------------------------------------------------------------------------
# Manifiesto
# ---------------------------------------------------------------------------


def load_manifest(repo):
    path = Path(repo) / MANIFEST_NAME
    if not path.is_file():
        raise MissingResourceError(
            f"manifest: {MANIFEST_NAME} no existe en {repo}. "
            f"El manifiesto de gobierno lo escribe la adopción del repo adoptante: "
            f"`ci-pattern adoption check --phase 3 {repo}` lo exige y lo verifica "
            f"(ver references/porting-guide.md)."
        )
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise MissingResourceError(f"manifest: {path} ilegible o corrupto ({exc}).") from exc
    if not isinstance(manifest, dict) or manifest.get("schema_version") != SCHEMA_VERSION:
        raise MissingResourceError(
            f"manifest: schema_version debe ser {SCHEMA_VERSION}; revise {path}."
        )
    return manifest


def write_manifest(repo, manifest):
    path = Path(repo) / MANIFEST_NAME
    path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return path


def sha256_file(path):
    """sha256 del contenido con saltos normalizados a LF (#187).

    Un fichero con CRLF (core.autocrlf en Windows) no es hallazgo: la
    regla de normalización es la misma para ficheros y slices.
    """
    digest = hashlib.sha256(Path(path).read_bytes().replace(b"\r\n", b"\n")).hexdigest()
    return f"sha256:{digest}"


# ---------------------------------------------------------------------------
# Parser del subconjunto YAML de ci-pattern.yaml
#
# Aceptado (determinista, sin dependencias):
#   - mapeo de un nivel con escalares, listas en bloque (- item) o inline [a, b]
#   - mapas anidados de un nivel (clave: /   subclave: valor)
#   - comentarios con # (fuera de comillas), cadenas con o sin comillas
# Rechazado con línea: tabulación, clave duplicada, indentación ambigua.
# ---------------------------------------------------------------------------


def _strip_comment(line):
    in_squote = in_dquote = False
    for i, ch in enumerate(line):
        if ch == "'" and not in_dquote:
            in_squote = not in_squote
        elif ch == '"' and not in_squote:
            in_dquote = not in_dquote
        elif ch == "#" and not in_squote and not in_dquote and (i == 0 or line[i - 1] in " \t"):
            return line[:i]
    return line


def _parse_scalar(text, lineno, key):
    text = text.strip()
    if text == "{}":
        return {}
    if text.startswith("[") and text.endswith("]"):
        inner = text[1:-1].strip()
        if not inner:
            return []
        return [_parse_scalar(item, lineno, key) for item in inner.split(",") if item.strip()]
    if (text.startswith('"') and text.endswith('"')) or (text.startswith("'") and text.endswith("'")):
        return text[1:-1]
    if text in ("true", "false"):
        return text == "true"
    if re.fullmatch(r"-?\d+", text):
        return int(text)
    if re.fullmatch(r"-?\d+\.\d+", text):
        return float(text)
    if text.startswith("[") or text.endswith("]"):
        raise ParamsFileError(f"línea {lineno}: lista sin cerrar en '{key}'.")
    if text.startswith("{") or text.endswith("}"):
        raise ParamsFileError(
            f"línea {lineno}: mapa inline no soportado en '{key}'; declare las claves en "
            "líneas indentadas o use '{}' para un mapa vacío."
        )
    return text


def parse_params_yaml(text):
    """Parsea el subconjunto YAML aceptado; devuelve un dict anidado.

    Profundidad arbitraria de mapas (P48 es un mapa de objetos) y listas
    en bloque o inline a cualquier nivel. Determinista, sin dependencias.
    """
    root = {}
    # Pila de (indent, contenedor_padre, clave): el contenedor real se
    # resuelve como padre[clave] y se materializa (dict o lista) con la
    # primera línea anidada que lo declara.
    stack = [(-1, None, None)]
    for lineno, raw in enumerate(text.splitlines(), start=1):
        if "\t" in raw:
            raise ParamsFileError(
                f"línea {lineno}: tabulación prohibida; use espacios para la indentación."
            )
        line = _strip_comment(raw).rstrip()
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" "))
        if 0 < indent < 2:
            raise ParamsFileError(f"línea {lineno}: indentación ambigua (use 2+ espacios).")
        stripped = line.strip()
        while len(stack) > 1 and indent <= stack[-1][0]:
            stack.pop()
        _indent, parent, key = stack[-1]
        container = root if key is None else parent[key]

        if stripped.startswith("- "):
            if key is None:
                raise ParamsFileError(
                    f"línea {lineno}: ítem de lista de primer nivel sin clave contenedora."
                )
            if container is None:
                container = parent[key] = []
            if not isinstance(container, list):
                raise ParamsFileError(
                    f"línea {lineno}: '{key}' mezcla mapa y lista."
                )
            container.append(_parse_scalar(stripped[2:], lineno, key))
            continue

        if ":" not in stripped:
            raise ParamsFileError(f"línea {lineno}: falta ':' tras la clave '{stripped}'.")
        new_key, _, rest = stripped.partition(":")
        new_key = new_key.strip()
        if key is None:
            if new_key in container:
                raise ParamsFileError(f"línea {lineno}: clave duplicada '{new_key}'.")
        else:
            if container is None:
                container = parent[key] = {}
            if not isinstance(container, dict):
                raise ParamsFileError(
                    f"línea {lineno}: '{key}' ya tiene valor escalar o lista; no admite subclaves."
                )
            if new_key in container:
                # #184: subclave duplicada se sobrescribía en silencio;
                # ahora es entrada inválida (exit 2).
                raise UsageError(
                    f"línea {lineno}: subclave duplicada '{new_key}' en '{key}'."
                )
        if rest.strip():
            container[new_key] = _parse_scalar(rest, lineno, new_key)
        else:
            container[new_key] = None
        stack.append((indent, container, new_key))
    return root


# ---------------------------------------------------------------------------
# Esquema y validación de parámetros
# ---------------------------------------------------------------------------


def load_schema():
    path = skill_dir() / "assets" / "parameters.schema.json"
    try:
        return json.loads(path.read_text(encoding="utf-8")), path
    except (OSError, json.JSONDecodeError) as exc:
        raise MissingResourceError(f"esquema de parámetros ilegible en {path}: {exc}") from exc


def validate_value(param, value):
    """Valida un valor contra su entrada del esquema; devuelve error o None."""
    ptype = param["type"]
    pid = f"{param['id']}_{param['name']}"

    def bad(expected, got_desc):
        return f"{pid}: debe ser {expected}, se recibió {got_desc}."

    if ptype == "regex":
        if not isinstance(value, str):
            return bad("regex (cadena)", _type_name(value))
        try:
            re.compile(value)
        except re.error as exc:
            return f"{pid}: no compila como regex ({exc})."
        return None
    if ptype == "label":
        if not isinstance(value, str) or not LABEL_RE.fullmatch(value):
            return (
                f"{pid}: debe ser una etiqueta con formato prefijo:valor "
                f"(p. ej. status:approved), se recibió {value!r}."
            )
        return None
    if ptype == "path":
        if not isinstance(value, str):
            return bad("ruta relativa al repo", _type_name(value))
        if value.startswith("/") or ".." in Path(value).parts:
            return f"{pid}: debe ser una ruta relativa al repo (sin '/' inicial ni '..'), se recibió {value!r}."
        if re.match(r"^[A-Za-z]:", value) or "\\" in value:
            return (
                f"{pid}: debe ser una ruta relativa al repo (separador '/', sin "
                f"letra de unidad ni ruta UNC de Windows), se recibió {value!r}."
            )
        return None
    if ptype == "url_path":
        if not isinstance(value, str):
            return bad("ruta URL que empiece por '/'", _type_name(value))
        if not value.startswith("/") or value.startswith("//"):
            return (
                f"{pid}: debe ser una ruta URL que empiece por '/' "
                f"(p. ej. '/healthz'), se recibió {value!r}."
            )
        if "\\" in value or " " in value:
            return f"{pid}: ruta URL inválida, se recibió {value!r}."
        return None
    if ptype == "integer":
        if not isinstance(value, int) or isinstance(value, bool):
            return bad("integer", _type_name(value))
        low = param.get("min")
        high = param.get("max")
        if low is not None and value < low:
            return f"{pid}: debe ser >= {low}, se recibió {value}."
        if high is not None and value > high:
            return f"{pid}: debe ser <= {high}, se recibió {value}."
        return None
    if ptype == "float":
        if not isinstance(value, (int, float)) or isinstance(value, bool):
            return bad("float", _type_name(value))
        low = param.get("min")
        high = param.get("max")
        if low is not None and value < low:
            return f"{pid}: debe ser >= {low}, se recibió {value}."
        if high is not None and value > high:
            return f"{pid}: debe ser <= {high}, se recibió {value}."
        return None
    if ptype == "boolean":
        if not isinstance(value, bool):
            return bad("boolean", _type_name(value))
        return None
    if ptype == "enum":
        if value not in param.get("choices", []):
            return f"{pid}: debe ser uno de {param.get('choices')}, se recibió {value!r}."
        return None
    if ptype == "string":
        if not isinstance(value, str):
            return bad("string", _type_name(value))
        pattern = param.get("pattern")
        if pattern and not re.fullmatch(pattern, value):
            return f"{pid}: debe casar con {pattern}, se recibió {value!r}."
        return None
    if ptype == "list":
        if not isinstance(value, list):
            return bad("lista", _type_name(value))
        item_type = param.get("item_type")
        if item_type:
            for idx, item in enumerate(value):
                sub = {"id": param["id"], "name": param["name"], "type": item_type}
                err = validate_value(sub, item)
                if err:
                    return f"elemento {idx + 1} de la lista {pid}: {err.split(': ', 1)[-1]}"
        return None
    if ptype == "map":
        if not isinstance(value, dict):
            return bad("mapa", _type_name(value))
        vtype = param.get("value_type")
        if vtype:
            for k, v in value.items():
                sub = (
                    {**vtype, "id": param["id"], "name": param["name"]}
                    if isinstance(vtype, dict)
                    else {"id": param["id"], "name": param["name"], "type": vtype}
                )
                err = validate_value(sub, v)
                if err:
                    return f"clave '{k}' del mapa {pid}: {err.split(': ', 1)[-1]}"
        return None
    if ptype == "object":
        if not isinstance(value, dict):
            return bad("objeto", _type_name(value))
        fields = param.get("fields")
        if fields:
            if not value:
                return f"{pid}: no puede ser un objeto vacío."
            declared = {f["name"] for f in fields}
            unknown = sorted(set(value) - declared)
            if unknown:
                return f"{pid}: campos desconocidos {unknown}; sólo se admiten {sorted(declared)}."
            for field in fields:
                fname = field["name"]
                if fname not in value:
                    if field.get("required"):
                        return f"{pid}: falta el campo requerido '{fname}'."
                    continue
                sub = {"id": param["id"], "name": param["name"], **field}
                err = validate_value(sub, value[fname])
                if err:
                    return f"campo '{fname}' de {pid}: {err.split(': ', 1)[-1]}"
            return None
        if param["id"] == "P22":
            attempts = value.get("attempts")
            interval = value.get("interval_s")
            if not isinstance(attempts, int) or attempts < 1:
                return f"{pid}: 'attempts' debe ser integer >= 1."
            if not isinstance(interval, (int, float)) or interval <= 0:
                return f"{pid}: 'interval_s' debe ser number > 0."
        return None
    return f"{pid}: tipo de esquema desconocido '{ptype}'."


def _type_name(value):
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, int):
        return "integer"
    if isinstance(value, float):
        return "float"
    if isinstance(value, list):
        return "lista"
    if isinstance(value, dict):
        return "mapa"
    if isinstance(value, str):
        return "cadena"
    return type(value).__name__


def validate_params_file(path, schema, schema_path):
    """Valida ci-pattern.yaml; devuelve (errores, params)."""
    errors = []
    try:
        text = Path(path).read_text(encoding="utf-8")
    except OSError as exc:
        raise MissingResourceError(f"fichero de parámetros ilegible {path}: {exc}") from exc
    try:
        params = parse_params_yaml(text)
    except ParamsFileError as exc:
        return [f"{path}: {exc}"], {}

    by_key = {f"{p['id']}_{p['name']}": p for p in schema["parameters"]}
    for key in params:
        if key not in by_key:
            errors.append(
                f"{key}: clave desconocida — no está en el esquema ({schema_path.name}). "
                f"Revise el nombre (forma P<NN>_<name>) o elimínela."
            )
    for key, param in by_key.items():
        if key in params:
            err = validate_value(param, params[key])
            if err:
                errors.append(err)
        elif param.get("required"):
            errors.append(
                f"{key}: falta — es obligatorio y no tiene default seguro; establézcalo "
                f"(consume: {', '.join(param.get('consumed_by', ['?']))})."
            )
    return errors, params


# ---------------------------------------------------------------------------
# Slice blocks
# ---------------------------------------------------------------------------


def extract_slice_block(text, name):
    """Devuelve (version, content) del bloque `personal-skills:slice:NAME` o None."""
    opening = re.compile(rf"<!--\s*personal-skills:slice:{re.escape(name)} @ (\S+)\s*-->[^\n]*\n")
    match = opening.search(text)
    if not match:
        return None
    closing = f"<!-- /personal-skills:slice:{name} -->"
    end = text.find(closing, match.end())
    if end == -1:
        return None
    return match.group(1), text[match.end():end]


# ---------------------------------------------------------------------------
# verify
# ---------------------------------------------------------------------------


# Job id válido de GitHub Actions (#232):^[A-Za-z_][A-Za-z0-9_-]*$
_JOB_ID_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*$")


def _ensure_safe_manifest_path(rel):
    """Rechaza claves del manifiesto que escapan del repositorio (#182)."""
    parts = PurePosixPath(rel).parts
    if (
        PurePosixPath(rel).is_absolute()
        or rel.startswith(("/", "\\"))
        or ".." in parts
        or ".." in rel
        or re.match(r"^[A-Za-z]:", rel)
    ):
        raise UsageError(
            f"la clave del manifiesto '{rel}' no es una ruta relativa segura "
            "(absoluta, con '..' o con letra de unidad Windows); rechazada."
        )


def _jobs_in_workflow(text):
    """Claves directas del bloque top-level `jobs:` de un workflow (#182).

    Detección estructural por indentación, no por regex de línea: la
    indentación de la PRIMERA clave hija fija el nivel de los jobs (2 u 4
    espacios, según el workflow); las líneas más profundas (`with:`,
    `steps:`, …) no son jobs cableados.
    """
    jobs = set()
    in_jobs = False
    child_indent = None
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if not line[0].isspace():
            in_jobs = line.strip() == "jobs:"
            child_indent = None
            continue
        if not in_jobs:
            continue
        indent = len(line) - len(line.lstrip(" "))
        if child_indent is None:
            child_indent = indent
        if indent != child_indent:
            continue
        m = re.match(r"^(\S[^:]*):\s*(?:#.*)?$", line.strip())
        if m:
            jobs.add(m.group(1).strip())
    return jobs


def _find_registry_consumer(slices_dir, name):
    """Localiza el consumer del registry cuyo name es el del bloque (#183).

    Devuelve (consumer, None) o (None, motivo). Fail closed: registry
    ausente o corrupto no se ignora nunca.
    """
    registry_path = Path(slices_dir).parent / "fleet" / "registry.json"
    if not registry_path.is_file():
        return None, f"no existe {registry_path}; no se puede determinar la composición."
    try:
        registry = json.loads(registry_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        return None, f"{registry_path} no es JSON válido ({exc}); no se puede determinar la composición."
    for entry in registry.get("repositories", []):
        if entry.get("name") == name:
            return entry, None
    return None, f"el consumer '{name}' no está en {registry_path}."


def _compose_canonical_body(slices_dir, consumer):
    """Compone el cuerpo exactamente como el propagador (#183).

    partial = slices/partials/<primary_type>.md (TrimEnd); fragment =
    Resolve-SliceFragment: primero slices/<canonical_name>/ y luego
    slices/<name>/ (TrimEnd). Las piezas vacías tras el recorte no
    cuentan (truthiness de PowerShell); las presentes se unen con una
    línea en blanco. Devuelve (cuerpo|None, descripción|None).
    """
    partial_path = Path(slices_dir) / "partials" / f"{consumer.get('primary_type')}.md"
    partial = partial_path.read_text(encoding="utf-8").rstrip() if partial_path.is_file() else None
    fragment_path = None
    for candidate in (consumer.get("canonical_name"), consumer.get("name")):
        if not candidate:
            continue
        p = Path(slices_dir) / candidate / "AGENTS.fragment.md"
        if p.is_file():
            fragment_path = p
            break
    fragment = fragment_path.read_text(encoding="utf-8").rstrip() if fragment_path else None
    parts = [piece for piece in (partial, fragment) if piece]
    if not parts:
        return None, None
    desc_parts = []
    if partial is not None and partial != "":
        desc_parts.append(f"partials/{consumer.get('primary_type')}.md")
    if fragment is not None and fragment != "":
        desc_parts.append(f"{fragment_path.parent.name}/AGENTS.fragment.md")
    return "\n\n".join(parts), " + ".join(desc_parts)


def _wired_jobs(wf_dir):
    wired = set()
    if wf_dir.is_dir():
        for wf in sorted(wf_dir.glob("*.y*ml")):
            wired |= _jobs_in_workflow(wf.read_text(encoding="utf-8", errors="replace"))
    return wired


def verify_repo(repo, slice_canonical=None):
    """Devuelve (findings, clean, canonical_comparison). Solo lectura."""
    findings = []
    manifest = load_manifest(repo)
    repo = Path(repo)

    # Validación de forma del manifiesto (#182): entradas degeneradas o
    # mal tipadas fallan cerrado con exit 2, sin traceback.
    params = manifest.get("parameters")
    if "parameters" in manifest and not isinstance(params, dict):
        raise UsageError(
            f"'parameters' debe ser un objeto; se recibió {type(params).__name__}; rechazado."
        )
    manifest_files = manifest.get("files")
    if "files" in manifest and not isinstance(manifest_files, dict):
        raise UsageError(
            f"'files' debe ser un objeto de ruta→sha256; se recibió {type(manifest_files).__name__}; rechazado."
        )
    manifest_slices = manifest.get("slice_blocks")
    if "slice_blocks" in manifest and not isinstance(manifest_slices, dict):
        raise UsageError(
            f"'slice_blocks' debe ser un objeto de nombre→sha256; se recibió {type(manifest_slices).__name__}; rechazado."
        )
    manifest_files = manifest_files or {}
    manifest_slices = manifest_slices or {}
    required_jobs = (params or {}).get("P23_required_jobs")
    if not manifest_files and not manifest_slices and required_jobs == []:
        raise UsageError(
            "el manifiesto no contiene nada verificable (files y slice_blocks "
            "vacíos y P23_required_jobs vacío); un manifiesto adoptado debe "
            "fijar al menos un elemento que verificar."
        )
    if required_jobs is not None and (
        not isinstance(required_jobs, list)
        or not all(isinstance(job, str) and job.strip() for job in required_jobs)
    ):
        raise UsageError(
            "P23_required_jobs debe ser una lista de cadenas no vacías; "
            "se recibió "
            + (
                "una cadena"
                if isinstance(required_jobs, str)
                else repr(required_jobs)
            )
            + "; rechazado."
        )
    # #232: cada entrada debe ser un job id válido de GitHub Actions; un
    # nombre con espacios o Unicode invisible pasaría como cadena no vacía
    # y produciría un falso gate-not-wired.
    if required_jobs:
        bad_jobs = [job for job in required_jobs if not _JOB_ID_RE.fullmatch(job)]
        if bad_jobs:
            raise UsageError(
                "P23_required_jobs debe contener solo job ids válidos de GitHub "
                "(^[A-Za-z_][A-Za-z0-9_-]*$); entradas inválidas: "
                + ", ".join(repr(job) for job in bad_jobs)
                + "; rechazado."
            )
    # #232: todas las claves se validan ANTES de leer cualquier fichero, y
    # el error lista TODAS las inválidas; no solo la primera encontrada.
    unsafe_keys = []
    for rel in manifest_files:
        try:
            _ensure_safe_manifest_path(rel)
        except UsageError:
            unsafe_keys.append(rel)
    if unsafe_keys:
        raise UsageError(
            "estas claves del manifiesto no son una ruta relativa segura "
            "(absoluta, con '..' o con letra de unidad Windows): "
            + ", ".join(repr(key) for key in unsafe_keys)
            + "; rechazadas antes de leer cualquier fichero."
        )

    # (a) ficheros del manifiesto: existencia + sha256
    for rel, expected in sorted(manifest_files.items()):
        target = repo / rel
        if not target.is_file():
            findings.append(("files", "missing", f"{rel} está en el manifiesto pero no existe en el repo."))
            continue
        actual = sha256_file(target)
        if actual != expected:
            findings.append(
                (
                    "files",
                    "locally-modified",
                    f"{rel} difiere del hash del manifiesto ({expected[:19]}…). "
                    "El contenido del repo manda; re-selle el manifiesto "
                    "(`.governance-manifest.json`) con el sha256 nuevo.",
                )
            )

    # (b) gates cableados: cada job de P23_required_jobs aparece como clave
    # directa del bloque `jobs:` en los workflows (detección estructural).
    if required_jobs is None:
        findings.append(
            (
                "gates",
                "parameters-absent",
                "P23_required_jobs no está en manifest.parameters; no se puede comprobar el cableado.",
            )
        )
    else:
        wired = _wired_jobs(repo / ".github" / "workflows")
        for job in required_jobs:
            if job not in wired:
                findings.append(
                    (
                        "gates",
                        "gate-not-wired",
                        f"el job requerido '{job}' no aparece como job en ningún workflow de .github/workflows/.",
                    )
                )

    # (c) bloques de slice: presencia + hash del manifiesto (+ canónica opcional)
    agents = repo / "AGENTS.md"
    agents_text = agents.read_text(encoding="utf-8") if agents.is_file() else None
    canonical_comparison = "skipped" if slice_canonical is None else "performed"
    for name, expected in sorted(manifest_slices.items()):
        if agents_text is None:
            findings.append(("slice_blocks", "missing", f"AGENTS.md no existe; no se encuentra el bloque '{name}'."))
            continue
        block = extract_slice_block(agents_text, name)
        if block is None:
            findings.append(
                ("slice_blocks", "missing", f"bloque 'personal-skills:slice:{name}' ausente en AGENTS.md.")
            )
            continue
        actual = "sha256:" + hashlib.sha256(block[1].replace("\r\n", "\n").encode("utf-8")).hexdigest()
        if actual != expected:
            findings.append(
                (
                    "slice_blocks",
                    "locally-modified",
                    f"el bloque '{name}' difiere del hash del manifiesto; re-propague o actualice el manifiesto.",
                )
            )
        if slice_canonical is not None:
            consumer, reason = _find_registry_consumer(slice_canonical, name)
            if consumer is None:
                findings.append(
                    (
                        "slice_blocks",
                        "canonical-unavailable",
                        f"bloque '{name}': {reason}",
                    )
                )
            else:
                composed, desc = _compose_canonical_body(slice_canonical, consumer)
                marker_version = block[0]
                if composed is None:
                    findings.append(
                        (
                            "slice_blocks",
                            "canonical-unavailable",
                            f"no hay partial ni fragment en el catálogo para '{name}'; nada que contrastar.",
                        )
                    )
                else:
                    expected_marker = "v" + hashlib.sha256(composed.encode("utf-8")).hexdigest()[:7]
                    if marker_version != expected_marker:
                        findings.append(
                            (
                                "slice_blocks",
                                "marker-mismatch",
                                f"el marcador '{marker_version}' del bloque '{name}' no es la versión de la "
                                f"composición canónica (esperada '{expected_marker}'); re-propague o actualice el manifiesto.",
                            )
                        )
                    # Normalización única: LF antes de comparar (#187).
                    if block[1].replace("\r\n", "\n") != composed.replace("\r\n", "\n") + "\n":
                        findings.append(
                            (
                                "slice_blocks",
                                "stale-vs-canonical",
                                f"el bloque '{name}' difiere de la composición canónica ({desc}); "
                                "el consumer quedó desfasado tras un avance del catálogo.",
                            )
                        )

    # (d) adopción (#276): si el consumer declara contrato, verify exige
    # `adoption check --all` en verde; sin contrato no cambia el veredicto.
    if (repo / ADOPTION_CONTRACT_NAME).is_file():
        adoption = load_adoption_contract(repo)
        for n in range(ADOPTION_PHASES):
            phase_findings = _phase_findings(repo, n, adoption["phases"].get(str(n)), adoption)
            if phase_findings:
                findings.extend(
                    ("adoption", "phase-incomplete", finding) for finding in phase_findings
                )
                if n < ADOPTION_PHASES - 1:
                    findings.append(
                        (
                            "adoption",
                            "phase-incomplete",
                            f"fases {n + 1}..{ADOPTION_PHASES - 1} no evaluadas: "
                            "ninguna fase pasa si la anterior no pasa.",
                        )
                    )
                break

    return findings, (not findings), canonical_comparison


# ---------------------------------------------------------------------------
# Comandos
# ---------------------------------------------------------------------------


def cmd_params_validate(args):
    if len(args) != 1:
        raise UsageError("params validate requiere exactamente un argumento: <file>.")
    schema, schema_path = load_schema()
    errors, _ = validate_params_file(args[0], schema, schema_path)
    if errors:
        print(f"params validate: {len(errors)} error(es) en {args[0]}")
        for err in errors:
            print(f"  ✗ {err}")
        print("  Corrija cada parámetro nombrado y re-ejecute antes de escribir nada.")
        return EXIT_FINDINGS
    print(f"params validate: OK — {args[0]} contra {schema_path.name}")
    return EXIT_OK


def cmd_verify(args):
    repo = None
    slice_canonical = None
    as_json = False
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--json":
            as_json = True
        elif arg == "--slice-canonical":
            i += 1
            if i >= len(args):
                raise UsageError("--slice-canonical requiere un directorio.")
            slice_canonical = args[i]
        elif repo is None:
            repo = arg
        else:
            raise UsageError(f"argumento inesperado en verify: {arg}")
        i += 1
    if repo is None:
        raise UsageError("verify requiere <repo>.")

    findings, clean, canonical_comparison = verify_repo(repo, slice_canonical)
    if as_json:
        manifest_path = Path(repo) / ".governance-manifest.json"
        manifest_sha256 = (
            "sha256:" + hashlib.sha256(manifest_path.read_bytes()).hexdigest()
            if manifest_path.is_file()
            else None
        )
        try:
            schema_version = load_manifest(repo).get("schema_version")
        except MissingResourceError:
            schema_version = None
        print(
            json.dumps(
                {
                    "repo": str(repo),
                    "clean": clean,
                    "findings": [{"class": c, "code": code, "detail": d} for c, code, d in findings],
                    "canonical_comparison": canonical_comparison,
                    "head_sha": _head_sha(repo),
                    "cli_version": CLI_VERSION,
                    "schema_version": schema_version,
                    "manifest_sha256": manifest_sha256,
                },
                indent=2,
            )
        )
    else:
        print(f"verify {repo}: {'limpio' if clean else f'{len(findings)} hallazgo(s)'}")
        by_class = {}
        for cls, _code, detail in findings:
            by_class.setdefault(cls, []).append(detail)
        for cls in ("manifest", "files", "gates", "slice_blocks", "adoption"):
            if cls in by_class:
                print(f"[{cls}]")
                for cls, code, detail in [(c, k, d) for c, k, d in findings if c == cls]:
                    print(f"  ✗ [{code}] {detail}")
        if canonical_comparison == "skipped":
            print("nota: comparación canónica de slice_blocks no ejecutada (use --slice-canonical <dir>).")
    for cls, code, detail in findings:
        if code == "canonical-unavailable":
            _print_friction_hint("verify", detail)
    return EXIT_OK if clean else EXIT_FINDINGS


def cmd_status(args):
    as_json = "--json" in args
    positional = [a for a in args if a != "--json"]
    if len(positional) != 1:
        raise UsageError("status requiere exactamente un argumento: <repo>.")
    repo = Path(positional[0])
    try:
        manifest = load_manifest(repo)
    except MissingResourceError as exc:
        if as_json:
            print(json.dumps({"repo": str(repo), "manifest": "absent", "error": str(exc)}))
        else:
            print(f"status {repo}: sin manifiesto — {exc}")
        return EXIT_MISSING

    findings, clean, canonical_comparison = verify_repo(repo)
    files_total = len(manifest.get("files", {}))
    files_bad = sum(1 for c, _code, _d in findings if c == "files")
    gates_total = manifest.get("parameters", {}).get("P23_required_jobs") or []
    gates_bad = sum(1 for c, _code, _d in findings if c == "gates")
    slices_total = len(manifest.get("slice_blocks", {}))
    slices_bad = sum(1 for c, _code, _d in findings if c == "slice_blocks")
    if as_json:
        print(
            json.dumps(
                {
                    "repo": str(repo),
                    "manifest": "present",
                    "canonical_version": manifest.get("canonical_version"),
                    "clean": clean,
                    "files": {"total": files_total, "findings": files_bad},
                    "gates": {"total": len(gates_total), "findings": gates_bad},
                    "slice_blocks": {"total": slices_total, "findings": slices_bad},
                    "canonical_comparison": canonical_comparison,
                },
                indent=2,
            )
        )
    else:
        print(
            f"status {repo}: manifiesto presente (canónica {manifest.get('canonical_version')}), "
            f"files {files_total - files_bad}/{files_total} OK, "
            f"gates {len(gates_total) - gates_bad}/{len(gates_total)} cableados, "
            f"slice_blocks {slices_total - slices_bad}/{slices_total} OK"
        )
    return EXIT_FINDINGS if findings else EXIT_OK


def cmd_manifest_show(args):
    positional = [a for a in args if a != "--json"]
    if len(positional) != 1:
        raise UsageError("manifest show requiere exactamente un argumento: <repo>.")
    manifest = load_manifest(positional[0])
    print(json.dumps(manifest, indent=2, sort_keys=True))
    return EXIT_OK


# ---------------------------------------------------------------------------
# report-friction (#198): fricciones de la skill detectadas en un consumer
# ---------------------------------------------------------------------------

FRICTION_RECURRENT_LABEL = "friction:recurrent"  # no protegida; HR-11

FRICTION_KINDS = ("skill-bug", "rule-unfulfillable", "doc-drift", "consumer-local")
_TOKEN_RE = re.compile(
    r"(ghp_[A-Za-z0-9]{16,}|gho_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{16,}"
    r"|AKIA[A-Z0-9]{12,}|sk-[A-Za-z0-9_\-]{16,})")


_FILE_EXTENSIONS = frozenset({
    "py", "json", "yaml", "yml", "md", "sh", "txt", "toml", "cfg", "ini",
    "js", "ts", "html", "css", "xml", "csv", "log", "lock", "example"})
_FQDN_RE = re.compile(r"\b[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+){2,}\b")


def _redact_fqdns(text):
    """Bare FQDNs -> <host>; filenames (known extension) survive (#198)."""
    def sub(m):
        host = m.group(0)
        last = host.rsplit(".", 1)[-1]
        return host if (not last.isalpha() or len(last) < 2
                        or last.lower() in _FILE_EXTENSIONS) else "<host>"
    return _FQDN_RE.sub(sub, text)


def _sanitize_friction_text(text, redactions):
    """Saneado determinista de la fricción (#198): tokens, emails+hosts,
    URLs, rutas absolutas (POSIX y Windows), términos --redact y bloques de
    código del consumer. Ningún dato sembrado sobrevive al cuerpo."""
    out = _TOKEN_RE.sub("<token>", text)
    out = re.sub(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", "<redacted>", out)
    out = re.sub(r"(https?://)[A-Za-z0-9._:-]+", r"\1<host>", out)
    out = re.sub(r"(?:/home/|/Users/|/root/|C:\\Users\\)[A-Za-z0-9._\-]+", "<path>", out)
    out = re.sub(r"(?<![\w.])/[A-Za-z0-9._\-/]{2,}", "<path>", out)
    out = re.sub(r"[A-Za-z]:\\[A-Za-z0-9._\\\-]+", "<path>", out)
    out = _redact_fqdns(out)
    out = re.sub(r"```.*?```", "<consumer-code omitted>", out, flags=re.S)
    for term in redactions:
        out = re.sub(re.escape(term), "<redacted>", out, flags=re.IGNORECASE)
    return out


def _friction_fingerprint(kind, gate, observed):
    """Huella estable: kind + gate + firma normalizada del error (rutas y
    dígitos fuera; dos entornos distintos con el mismo defecto coinciden)."""
    sig = observed
    sig = re.sub(r"(?:/home/|/Users/|/root/|C:\\Users\\)[A-Za-z0-9._\-]+", "<path>", sig)
    sig = re.sub(r"(?<![\w.])/[A-Za-z0-9._\-/]{2,}", "<path>", sig)
    sig = re.sub(r"[A-Za-z]:\\[A-Za-z0-9._\\\-]+", "<path>", sig)
    sig = re.sub(r"\d+", "N", sig)
    sig = re.sub(r"\s+", " ", sig).strip().lower()
    return hashlib.sha256(f"{kind}|{gate}|{sig}".encode("utf-8")).hexdigest()[:16]


def _parse_friction_args(args):
    flags = {}
    i = 0
    while i < len(args):
        flag = args[i]
        if not flag.startswith("--"):
            raise UsageError(f"report-friction: argumento inesperado: {flag!r}.")
        if flag == "--publish":
            flags["publish"] = True
            i += 1
            continue
        if i + 1 >= len(args):
            raise UsageError(
                f"report-friction: {flag} requiere un valor y llegó sin él; rechazado.")
        if flag == "--redact":
            flags.setdefault("redact", []).append(args[i + 1])
            i += 2
            continue
        flags[flag[2:]] = args[i + 1]
        i += 2
    return flags


def _print_friction_hint(gate, observed, kind="skill-bug"):
    """#198: los gates que detectan un fallo propio (traceback, entrada no
    soportada, canonical-unavailable) imprimen la invocación de
    report-friction ya rellenada; la IA del consumer solo la confirma."""
    sanitized = _sanitize_friction_text(f"{gate}: {observed}", [])
    print("#198 — ¿es un defecto de la skill? Confirme la invocación ya rellenada:")
    print(f"  ci-pattern report-friction --kind {kind} --gate {gate} "
          f"--skill-version <versión> --skill-sha <sha> "
          f"--command '{gate}' --observed '{sanitized}' "
          f"--expected '<corríjalo aquí>' --repro '<pasos mínimos>'")


def cmd_report_friction(args):
    """#198: prepara un reporte de fricción saneado y clasificado.
    Por defecto escribe el cuerpo con --dry-run y no toca la red; la
    publicación real (`--publish` + gh autenticado) llega en el slice 2
    junto con la deduplicación por huella."""
    f = _parse_friction_args(args)
    kind = f.get("kind")
    if kind not in FRICTION_KINDS:
        raise UsageError(
            f"--kind debe ser uno de {list(FRICTION_KINDS)} (clasificación "
            "explícita, nunca deducida del texto); rechazado." if kind is None else
            f"--kind desconocido: {kind!r}; debe ser uno de {list(FRICTION_KINDS)}; rechazado.")
    required = ("gate", "skill-version", "skill-sha", "command",
                "observed", "expected", "repro")
    if not f.get("publish"):
        required += ("dry-run",)
    missing = [k for k in required if not f.get(k)]
    if missing:
        raise UsageError("report-friction: campos obligatorios ausentes: "
                         + ", ".join("--" + m for m in missing) + ".")
    destination = "consumer" if kind == "consumer-local" else "team-skills"
    sanitizer = lambda t: _sanitize_friction_text(t, f.get("redact", []))
    observed, expected = sanitizer(f["observed"]), sanitizer(f["expected"])
    repro, command = sanitizer(f["repro"]), sanitizer(f["command"])
    gate = sanitizer(f["gate"])
    hr = sanitizer(f.get("hr", ""))
    sver, ssha = sanitizer(f["skill-version"]), sanitizer(f["skill-sha"])
    fingerprint = _friction_fingerprint(kind, f["gate"], observed)
    body = (
        f"<!-- ci-pattern-friction: {fingerprint} -->\n"
        "### Change type\n\nTooling\n\n"
        "### Problem\n\n"
        f"Fricción detectada por el harness de ci-pattern en un consumer, "
        f"clasificada explícitamente como `{kind}` → destino `{destination}`.\n"
        f"- Gate/asset: `{gate}`" + (f" (HR: {hr})" if hr else "") + "\n"
        f"- Versión/SHA de la skill: {sver} @ {ssha}\n"
        f"- Comando: `{command}`\n\n" + (
        "La salida observada contradice el contrato de la skill: el defecto "
        "es atribuible a la skill, no al consumer." if destination == "team-skills" else
        "La skill se comporta según contrato: la fricción es local del "
        "consumer y no corresponde reportarla a team-skills.") + "\n\n"
        "### Desired outcome\n\n"
        f"Salida esperada: {expected}\n\n"
        "### Scope and constraints\n\n" + (
        "Corregir en la skill (este repositorio); el consumer no puede "
        "arreglarlo localmente. " if destination == "team-skills" else
        "Se registra en el tracker del consumer. ") +
        "Reporte generado y saneado por "
        "`report-friction` (#198) en modo dry-run.\n\n"
        "### Evidence and references\n\n"
        f"Salida observada:\n\n{observed}\n\n"
        f"Reproducción mínima:\n\n{repro}\n\n"
        "### Duplicate search\n\n"
        f"Huella de deduplicación: `ci-pattern-friction: {fingerprint}` "
        "(la búsqueda y el comentario de ocurrencia llegan en el slice 2).\n"
    )
    marker = f"ci-pattern-friction: {fingerprint}"
    if not f.get("publish"):
        out_path = Path(f["dry-run"])
        out_path.write_text(body, encoding="utf-8")
        print(f"report-friction: destination={destination} fingerprint={marker}")
        print(f"dry-run: reporte saneado escrito en {out_path} (sin red; nada publicado)")
        return EXIT_OK

    # Publicación real (#198 slice 2): requiere gh ya autenticado; dedup por
    # huella ANTES de crear; una sola llamada por operación, sin reintentos;
    # el resultado se verifica leyendo de vuelta (confirmed|no_write|unknown).
    target = f.get("repo", "DysTelefonica/team-skills")
    if kind == "consumer-local" and (not f.get("repo") or target == "DysTelefonica/team-skills"):
        raise UsageError(
            "consumer-local NUNCA se publica en team-skills: pase --repo <repo-del-consumer>. Rechazado.")

    def gh(*argv):
        return _run_cmd(["gh", *argv], timeout=120)

    occ_files = []
    try:
        search = gh("issue", "list", "-R", target, "--state", "all",
                    "--limit", "200", "--search", marker, "--json", "number,state")
        if search.returncode != 0:
            raise UsageError(
                "gh falló al buscar duplicados; no se publica sin deduplicación "
                f"(HR-3): {search.stderr.strip()}")
        match = None
        for cand in json.loads(search.stdout or "[]"):
            # gh issue view --json no expone state_reason: la lectura del
            # candidato se hace por la API REST (body/state/state_reason).
            view = gh("api", f"repos/{target}/issues/{cand['number']}")
            if view.returncode != 0:
                raise UsageError(
                    f"gh falló leyendo el candidato #{cand['number']}; no se publica "
                    f"sin deduplicación completa (HR-3): {view.stderr.strip()}")
            data = json.loads(view.stdout or "{}")
            if marker in (data.get("body") or ""):
                match = (cand["number"], data.get("state", "OPEN"),
                         data.get("state_reason"))
                break
        if match:
            number, state, state_reason = match
            if str(state).lower() == "closed" and str(state_reason or "").lower() == "completed":
                print(f"report-friction: result=no_write — el equivalente #{number} "
                      "está cerrado como completed; recomendación: actualizar la "
                      "skill en el consumer (verifica si el fix ya cubre tu "
                      "versión) en vez de reportar de nuevo.")
                return EXIT_OK
            comments = gh("api", f"repos/{target}/issues/{number}/comments", "--paginate")
            if comments.returncode != 0:
                raise UsageError(f"gh falló leyendo comentarios de #{number} (HR-3): {comments.stderr.strip()}")
            count = 1 + sum(1 for c in json.loads(comments.stdout or "[]")
                            if marker in (c.get("body") or ""))
            occ_body = (f"Ocurrencia {count} detectada por `report-friction` "
                        f"({sver} @ {ssha}).\n\n- Comando: `{command}`\n"
                        f"Salida observada:\n\n{observed}\n\n<!-- {marker} -->\n")
            with tempfile.NamedTemporaryFile(mode="w", suffix=".md", delete=False,
                                             encoding="utf-8") as fh:
                occ_file = Path(fh.name)
                fh.write(occ_body)
            occ_files.append(occ_file)
            com = gh("issue", "comment", str(number), "-R", target, "--body-file", str(occ_file))
            readback = gh("api", f"repos/{target}/issues/{number}/comments", "--paginate")
            confirmed = (com.returncode == 0 and readback.returncode == 0
                         and any(occ_body.strip() in (c.get("body") or "")
                                 for c in json.loads(readback.stdout or "[]")))
            if not confirmed:
                print("report-friction: result=unknown (la lectura de vuelta no "
                      "confirmó la escritura; nada dado por confirmado)")
                return 1
            print(f"report-friction: result=confirmed — Ocurrencia {count} "
                  f"registrada como comentario en #{number}")
            if count >= 2:
                lab = gh("issue", "edit", str(number), "-R", target,
                         "--add-label", FRICTION_RECURRENT_LABEL)
                if lab.returncode != 0:
                    print(f"report-friction: etiqueta {FRICTION_RECURRENT_LABEL} fallida "
                          f"({lab.stderr.strip()}); el comentario quedó confirmado.")
                else:
                    print(f"report-friction: etiqueta {FRICTION_RECURRENT_LABEL} aplicada "
                          "(candidata a automatización, HR-11).")
            return EXIT_OK

        with tempfile.NamedTemporaryFile(mode="w", suffix=".md", delete=False,
                                         encoding="utf-8") as fh:
            body_file = Path(fh.name)
            fh.write(body)
        occ_files.append(body_file)
        title = f"friction({kind}): {gate} — {fingerprint}"
        create = gh("issue", "create", "-R", target, "--title", title,
                    "--body-file", str(body_file))
        if create.returncode != 0 or not create.stdout.strip():
            print("report-friction: result=unknown (gh no confirmó la creación)")
            return 1
        url = create.stdout.strip().splitlines()[-1]
        number = url.rstrip("/").rsplit("/", 1)[-1]
        readback = gh("issue", "view", number, "-R", target, "--json", "number,state,body")
        ok = (readback.returncode == 0 and number.isdigit()
              and marker in (json.loads(readback.stdout or "{}").get("body") or ""))
        if not ok:
            print("report-friction: result=unknown (la lectura de vuelta no "
                  "confirmó la issue; nada dado por confirmado)")
            return 1
        print(f"report-friction: result=confirmed — issue #{number} creada: {url}")
        return EXIT_OK
    finally:
        for occ_file in occ_files:
            try:
                occ_file.unlink()
            except OSError:
                pass


# ------------------------------------------------------------- adopción (#276)

ADOPTION_HELP = """\
adoption — generación y gate por fase de la adopción (#276, #279)

uso: ci-pattern adoption check (--phase N | --all) <repo>
     ci-pattern adoption generate-doc <repo> --out <ruta>

check: valida el contrato .github/ci-pattern-adoption.json del consumer y
verifica cada fase del porting-guide contra el árbol real. Exit: 0 la fase
cumple · 1 hallazgos nombrando cada artefacto o condición que falta · 2
contrato ilegible, esquema inválido, sujeto vacío o entrada ausente de un
gate.

generate-doc: escribe el documento operativo del consumer (--out), generado
desde sus datos (ci-pattern.yaml, host-contract, required-jobs, formularios
de issue). Determinista byte a byte; nunca a stdout. Entrada ilegible →
exit 2.
"""


def load_adoption_contract(repo):
    """Carga y valida la forma del contrato de adopción del consumer.
    Cualquier defecto de forma es exit 2 (UsageError)."""
    path = Path(repo) / ADOPTION_CONTRACT_NAME
    if not path.is_file():
        raise UsageError(
            f"contrato de adopción ausente: {path}; el consumer declara su "
            "adopción en ese fichero (esquema: assets/adoption/)"
        )
    try:
        doc = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise UsageError(f"contrato de adopción ilegible ({path}): JSON inválido: {exc}")
    if not isinstance(doc, dict):
        raise UsageError(
            f"contrato de adopción ilegible ({path}): debe ser un objeto JSON"
        )
    if doc.get("schema_version") != ADOPTION_SCHEMA_VERSION:
        raise UsageError(
            f"schema_version del contrato debe ser {ADOPTION_SCHEMA_VERSION}; "
            f"se recibió {doc.get('schema_version')!r}"
        )
    phases = doc.get("phases")
    if not isinstance(phases, dict):
        raise UsageError(
            f"'phases' del contrato debe ser un objeto fase→declaración; "
            f"se recibió {type(phases).__name__}"
        )
    valid_keys = {str(i) for i in range(ADOPTION_PHASES)}
    unknown = sorted(set(phases) - valid_keys)
    if unknown:
        raise UsageError(
            "fases desconocidas en el contrato: "
            + ", ".join(unknown)
            + f"; fases válidas 0..{ADOPTION_PHASES - 1}"
        )
    return doc


def _is_canonical_pattern_target(target, repo=None, declared=()):
    """#306/#311: catálogo canónico del patrón — ubicaciones donde el patrón
    instala (globs del catálogo), el espacio ruleset:<nombre>, los scripts
    que el gobierno REFERENCIA (#311) y los que el contrato del consumer
    declara explícitamente. La fase 0 solo exige pertenencia al catálogo; la
    EXISTENCIA y la identidad (manifiesto) las verifica la fase 3, que es la
    que instala."""
    patterns, namespaces, refs = load_pattern_catalog()
    if any(target.startswith(ns) for ns in namespaces):
        return True
    if any(fnmatch.fnmatch(target, pattern) for pattern in patterns):
        return True
    if target in declared:
        return True
    return (repo is not None
            and target in _referenced_governance_scripts(repo, refs))


def _check_phase_zero(repo, decl):
    findings = []
    declared_paths = _declared_governed_paths(decl)
    inventory = decl.get("inventory")
    if not isinstance(inventory, list) or not inventory:
        return [
            "fase 0: 'inventory' debe ser una lista no vacía: cada artefacto de "
            "gobierno del destino con su destino (adopted/retired), sin tercera opción"
        ]
    for entry in inventory:
        if not isinstance(entry, dict):
            findings.append("fase 0: entrada de inventario no-objeto: " + repr(entry)[:80])
            continue
        artifact = entry.get("artifact")
        disposition = entry.get("disposition")
        if not isinstance(artifact, str) or not artifact.strip():
            findings.append("fase 0: entrada de inventario sin 'artifact' no vacío")
            continue
        if disposition not in ("adopted", "retired"):
            findings.append(
                f"fase 0: '{artifact}' tiene disposición inválida {disposition!r}; "
                "solo 'adopted' o 'retired' (lo que no viene del patrón se elimina)"
            )
        elif disposition == "retired":
            # #306: el gobierno ajeno se ELIMINA en la fase 3; la fase 0 solo
            # registra la eliminación confirmada (removal_confirmed). La
            # presencia residual de un retired la ejecuta la fase 3, que es
            # donde el árbol ya debe estar sustituido.
            pass
        elif disposition == "adopted":
            target = entry.get("target")
            if not isinstance(target, str) or not target.strip():
                findings.append(f"fase 0: '{artifact}' adoptado sin 'target' no vacío")
            elif not _is_canonical_pattern_target(target, repo, declared_paths):
                findings.append(
                    f"fase 0: '{artifact}' adoptado hacia '{target}', que no es un "
                    "artefacto canónico del patrón: el catálogo de instalación ("
                    + PATTERN_CATALOG_RELPATH + ") es "
                    + ", ".join(load_pattern_catalog()[0]) + " y "
                    + ", ".join(load_pattern_catalog()[1]) + "; la gobernanza de "
                    "scripts es por REFERENCIA (#311/#312: los `run:` de los workflows "
                    "de CI, los hooks y el entrypoint de paridad HR-4) o por "
                    "declaración explícita en 'declared_governed_paths' "
                    "(#306; los targets canónicos se INSTALAN y se verifican en la "
                    "fase 3, no en la fase 0)"
                )
    # #312: la fase 0 EJECUTA la cobertura del inventario (HR-3: sin medir
    # no hay pase) — rutas gobernadas del árbol según el catálogo, etiquetas
    # del host vía instantánea declarada (sin red) y cada una exige entrada.
    labels_rel = decl.get("host_labels")
    if not isinstance(labels_rel, str) or not labels_rel.strip():
        findings.append(
            "fase 0: falta 'host_labels' (ruta relativa de la instantánea de "
            "etiquetas del host, JSON versionado generado por el operador con "
            "GET de solo lectura): la fase 0 comprueba la cobertura del "
            "inventario sobre las etiquetas del host (#312)"
        )
    else:
        labels_rel = labels_rel.strip()
        try:
            labels = json.loads((repo / labels_rel).read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise UsageError(
                f"fase 0: la instantánea de etiquetas declarada no es legible "
                f"({labels_rel}): {exc}")
        if not isinstance(labels, list) or not all(isinstance(x, str) for x in labels):
            raise UsageError(
                "fase 0: la instantánea de etiquetas debe ser una lista de "
                "cadenas (nombres de etiqueta)")
        for name in labels:
            if not any(isinstance(e, dict) and name in (e.get("artifact") or "")
                       for e in inventory):
                findings.append(
                    f"fase 0: la etiqueta del host '{name}' no está inventariada "
                    "(falta una entrada cuyo artifact la nombre)")
    declared_inputs = {ADOPTION_CONTRACT_NAME}
    if isinstance(labels_rel, str) and labels_rel.strip():
        declared_inputs.add(labels_rel.strip())
    for rel in _scan_governed_paths(repo, declared_paths):
        if rel in declared_inputs:
            continue
        if _inventory_entry_covering(inventory, rel) is None:
            findings.append(
                f"fase 0: artefacto de gobierno sin entrada de inventario: {rel}")
    if decl.get("removal_confirmed") is not True:
        findings.append(
            "fase 0: 'removal_confirmed' debe ser true: la lista de eliminación "
            "de gobernanza la confirma el operador (porting-guide, fase 0)"
        )
    return findings


def _check_evidence_phase(repo, n, decl):
    evidence = decl.get("evidence")
    if not isinstance(evidence, dict) or not isinstance(evidence.get("path"), str) \
            or not evidence["path"].strip():
        return [f"fase {n}: falta 'evidence.path': la evidencia de la fase se declara como ruta"]
    rel = evidence["path"]
    path = repo / rel
    if not path.is_file():
        return [f"fase {n}: la evidencia declarada no existe: {rel}"]
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        return [f"fase {n}: la evidencia declarada no es legible: {rel}: {exc}"]
    if not text.strip():
        return [f"fase {n}: la evidencia declarada está vacía: {rel}"]
    return []



def _sha_in_history(repo, sha):
    """True si el sha existe como objeto en el historial del repo (git
    cat-file -e, sin red). Un repo no-git falla cerrado: False."""
    proc = _run_cmd(
        ["git", "-C", str(repo), "cat-file", "-e", sha + "^{commit}"],
        timeout=60)
    return proc.returncode == 0


def _check_acceptance_phase(repo, decl):
    prs = decl.get("prs")
    if not isinstance(prs, list) or not prs:
        return [
            "fase 6: 'prs' debe ser una lista no vacía de la primera cadena de "
            "PRs de aceptación (número, SHA y veredicto de CI)"
        ]
    findings = []
    for entry in prs:
        if not isinstance(entry, dict):
            findings.append("fase 6: entrada de 'prs' no-objeto: " + repr(entry)[:80])
            continue
        number = entry.get("number")
        sha = entry.get("sha")
        conclusion = entry.get("conclusion")
        if not isinstance(number, int) or isinstance(number, bool) or number < 1:
            findings.append(f"fase 6: entrada de 'prs' con 'number' inválido: {number!r}")
        if not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{40}", sha or ""):
            findings.append(
                f"fase 6: PR {number!r} con 'sha' inválido ({sha!r}): debe ser el "
                "SHA completo de 40 hex de la revisión evaluada"
            )
        if conclusion != "success":
            findings.append(
                f"fase 6: PR {number!r} con veredicto {conclusion!r}: la cadena de "
                "aceptación exige CI en verde (conclusion: success)"
            )
        elif isinstance(sha, str) and re.fullmatch(r"[0-9a-f]{40}", sha) \
                and not _sha_in_history(repo, sha):
            findings.append(
                f"fase 6: el SHA {sha} del PR {number!r} no existe en el historial "
                "del repo (git cat-file -e): una aceptación sobre una revisión "
                "que no está en el árbol es fabricada"
            )
    return findings


