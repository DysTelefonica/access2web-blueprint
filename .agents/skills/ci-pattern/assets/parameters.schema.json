    "consumed_by": [
      "assets/runner-profile/check_runner_profile.py"
    ],
    "description": "Conjunto exacto de etiquetas del pool self-hosted gobernable (orden irrelevante). Vacia con P51=self-hosted es entrada invalida, fail-closed: 'self-hosted' pelado goberna cualquier runner conectado, incluido un portatil personal."
  },
    {
    "id": "P53",
    "name": "hosted_exceptions",
    "type": "map",
    "value_type": "string",
    "default": {},
    "required": false,
